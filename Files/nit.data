#Prohgram for Copying the content of One File into Another File
#FileCopyEx.py
def filecopy():
    try:
        srcfile=input("Enter Source File:")
        with open(srcfile,"r") as rp:
            dstfile=input("Enter Destination File:")
            with open(dstfile,"a") as wp:
                #read the source file Data
                srcfiledata=rp.read()
                #Write the source file data to Destination file
                wp.write(srcfiledata)
                print("File Copied Successfully")
    except FileNotFoundError:
        print("Source File Does Not Found")

